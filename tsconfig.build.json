{
	"compilerOptions": {
		"declaration": true,
		"declarationDir": "types",
		"emitDeclarationOnly": true,
		// esbuild compiles each file alone, so tsc rejects code that needs another file to compile.
		"isolatedModules": true,
		"module": "NodeNext",
		"strict": true,
		// The target is the browser floor README → Runtimes states: tsc lowers newer syntax and
		// rejects newer built-ins, so the floor can't rise unnoticed.
		"target": "ES2020",
		"types": ["node"]
	},
	"files": ["index.ts"]
}
