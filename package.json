{
  "name": "@larvit/log",
  "description": "Structured logging with a tiny API, plus OTLP export of logs and traces from Node, Bun, Deno, browsers and React Native. No OpenTelemetry SDK, no dependencies.",
  "version": "2.6.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node release-tooling/build.mjs",
    "build-tests": "node release-tooling/build-tests.mjs",
    "ci": "npm run build-tests && npm run test-node",
    "ci-browser": "npm run build-tests && node e2e-tests/run-browser-tests.mjs",
    "lint": "eslint eslint.config.js index.ts otel.ts credentials e2e-tests log opentelemetry-adapter otlp primitives release-tooling tracing tests",
    "lint-fix": "eslint --fix eslint.config.js index.ts otel.ts credentials e2e-tests log opentelemetry-adapter otlp primitives release-tooling tracing tests",
    "test": "npm run test-docker && npm run test-browser",
    "test-browser": "node release-tooling/test-browser.mjs",
    "test-docker": "release-tooling/test-in-docker.py",
    "test-mutation": "docker run --rm --memory 4g --memory-swap 4g \"$(docker build -q .)\" npx stryker run",
    "test-node": "node release-tooling/test-node.mjs",
    "test-otlp": "node e2e-tests/test-otlp.mjs"
  },
  "devDependencies": {
    "@larvit/eslint-config-typescript-esm": "2.0.0",
    "@opentelemetry/api": "1.10.0",
    "@stryker-mutator/core": "10.1.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "globals": "17.14.0",
    "playwright": "1.65.0",
    "typescript": "6.0.3",
    "uglify-js": "3.19.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.3.0 <2"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larvit/log.git"
  },
  "main": "index.js",
  "types": "types/index.d.ts",
  "typesVersions": {
    "*": {
      "otel": ["types/otel.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./otel": {
      "types": "./types/otel.d.ts",
      "default": "./otel.js"
    }
  },
  "sideEffects": false,
  "files": [
    "index.js",
    "index.js.map",
    "LICENSE",
    "otel.js",
    "otel.js.map",
    "package.json",
    "README.md",
    "types"
  ]
}
