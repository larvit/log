{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"automerge": true,
	"customManagers": [
		{
			"customType": "regex",
			"datasourceTemplate": "docker",
			"managerFilePatterns": [
				"/^\\.github/workflows/push\\.yaml$/"
			],
			"matchStrings": [
				"(?<depName>node):(?<currentValue>\\d+\\.\\d+\\.\\d+-bookworm-slim)"
			]
		}
	],
	"extends": [
		"config:recommended"
	],
	"minimumReleaseAge": "3 days",
	"packageRules": [
		{
			"description": "A matrix entry stays on its Node major.",
			"enabled": false,
			"matchFileNames": [
				".github/workflows/push.yaml"
			],
			"matchUpdateTypes": [
				"major"
			]
		}
	]
}
